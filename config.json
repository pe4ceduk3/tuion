{
  "config_version": 2,
  "storage_path": "./rag_storage",
  "loading_timeout_seconds": 600,
  "embedding": {
    "model_name": "BAAI/bge-small-en-v1.5"
  },
  "search": {
    "default_top_k": 8,
    "mode": "hybrid",
    "rrf_k": 60,
    "candidate_pool_size": 30,
    "deep": {
      "min_results": 2,
      "score_thresholds": {
        "dense": 0.45,
        "hybrid": 0.012,
        "sparse": 3.0
      }
    },
    "reranker": {
      "enabled": false,
      "model_name": "cross-encoder/ms-marco-MiniLM-L-6-v2",
      "top_n_before_rerank": 30
    }
  },
  "sources": {
    "tuion": {
      "type": "codebase",
      "path": "/home/duke/projects/tuion",
      "supported_extensions": [
        ".txt",
        ".rs",
        ".lock",
        ".json",
        ".toml",
        ".ttf"
      ],
      "ignored_path_fragments": [
        "/.git/",
        "/.venv/",
        "/venv/",
        "/node_modules/",
        "/__pycache__/",
        "/.idea/",
        "/.vscode/",
        "/dist/",
        "/build/",
        "/target/",
        "/.next/"
      ]
    }
  }
}
